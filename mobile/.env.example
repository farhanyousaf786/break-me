# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in: Firebase console → Authentication → Sign-in method → Google → Web SDK configuration → Web client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# In-app purchases: RevenueCat → Project settings → API keys (public app-specific keys).
# Leave empty in dev to use simulated test purchases.
# Android: goog_…  iOS: appl_…  (EAS cloud builds don't read .env.local — add these under
# expo.dev → Project → Environment variables too.)
# AdMob IDs are not secrets and live in code: src/monetize/android/keys.ts, src/monetize/ios/keys.ts, app.json.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Public HTTPS pages for Play Console + first-launch consent.
# Live: https://www.switchtofuture.com/break-buddies/privacy-policy
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://www.switchtofuture.com/break-buddies/privacy-policy
EXPO_PUBLIC_TERMS_URL=https://www.switchtofuture.com/break-buddies/terms
